# ═══════════════════════════════════════════════════════════════════════════
# DIVISIONJURIDIQUE — ملف .gitignore احترافي
# يحدد جميع الملفات والمجلدات التي يجب عدم رفعها إلى GitHub
# ═══════════════════════════════════════════════════════════════════════════

# ── التبعيات ─────────────────────────────────────────────────────────────
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── الاختبار ─────────────────────────────────────────────────────────────
/coverage

# ── Next.js ──────────────────────────────────────────────────────────────
/.next/
/out/

# ── الإنتاج ──────────────────────────────────────────────────────────────
/build

# ── ملفات النظام ─────────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db

# ── التصحيح ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
server.log

# ── ملفات البيئة الحساسة ────────────────────────────────────────────────
.env
.env.local
.env.production
.env.development
.env.*.local

# ── Vercel ───────────────────────────────────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
local-*

# ── IDE ومحررات الكود ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── أدوات الذكاء الاصطناعي ───────────────────────────────────────────────
.claude
.z-ai-config
.aider*

# ── ملفات حساسة — يجب عدم رفعها أبداً ──────────────────────────────────
.mcp.json
.config_backup
.accesslog
.stats
worklog.md
.zscripts/

# ── مجلدات مؤقتة / مكررة ────────────────────────────────────────────────
original/
download/
__pycache__/
venv/
.venv/
temp/
tmp/
cache/
*.pyc
*.pyo

# ── ملفات مؤقتة متنوعة ──────────────────────────────────────────────────
3001
test.txt
prompt

# ── قاعدة البيانات المحلية ───────────────────────────────────────────────
db/
*.db
*.db-journal
prisma/dev.db

# ── Upload directory (ملفات كبيرة) ──────────────────────────────────────
upload/

# ── Skills directory (أدوات الوكيل الداخلية) ────────────────────────────
/skills/

# ── ملفات PDF المؤقتة ─────────────────────────────────────────────────────
*.pdf.tmp
