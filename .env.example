# ═══════════════════════════════════════════════════════════════════════════
# DIVISIONJURIDIQUE — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية
# cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات ─────────────────────────────────────────────────────────
DATABASE_URL=file:./dev.db

# ── مفاتيح الذكاء الاصطناعي ────────────────────────────────────────────────
# OpenRouter (المزود الأول — نموذج مجاني)
OPENROUTER_API_KEY=

# Google Gemini (المزود الثاني — 4 مفاتيح بالتناوب)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Groq (المزود الثالث — خط الدفاع الأخير)
GROQ_API_KEY=

# ── Redis (Upstash) — تخزين مؤقت وتقييد الطلبات ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── أمان ─────────────────────────────────────────────────────────────────────
# مفتاح سري لحماية نقاط API الداخلية (cron, debug)
CRON_SECRET=

# ── أدوات PDF ────────────────────────────────────────────────────────────────
ILOVEPDF_SECRET_KEY=
