# ═══════════════════════════════════════════════════════════════════════════
# DIVISIONJURIDIQUE — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env.local وأضف القيم الحقيقية
# cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════════════════

# ── قاعدة البيانات ─────────────────────────────────────────────────────────
DATABASE_URL=file:./dev.db

# ── مفاتيح الذكاء الاصطناعي ────────────────────────────────────────────────
# Google Gemini — المزود الأساسي (Tier 0+1)
# يمكن تعيين نفس المفتاح لجميع المتغيرات أو مفاتيح مختلفة للتوزيع
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# NVIDIA NIM — Fallback اختياري (Tier 2)
NVIDIA_API_KEY=

# OpenRouter — Fallback اختياري (Tier 3)
OPENROUTER_API_KEY=

# Groq — خط الدفاع الأخير (Tier 4)
GROQ_API_KEY=

# ── Redis (Upstash) — تخزين مؤقت وتقييد الطلبات ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── أمان ─────────────────────────────────────────────────────────────────────
# مفتاح سري لحماية نقاط API الداخلية (cron, debug)
CRON_SECRET=

# ── أدوات PDF ────────────────────────────────────────────────────────────────
ILOVEPDF_SECRET_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
# مفتاح الوصول لـ GitHub (للأتمتة ورفع التحديثات)
GITHUB_TOKEN=
